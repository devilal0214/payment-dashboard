# ======================================================
# ReFly Payment Dashboard — Environment Variables
# ======================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ======================================================

# --- Reporting Database (READ-ONLY user) ---
REPORT_DB_HOST=127.0.0.1
REPORT_DB_PORT=3306
REPORT_DB_USER=refly_reporting_ro
REPORT_DB_PASS=your_secure_password_here
REPORT_DB_NAME=zendesk_reporting
REPORT_DB_POOL_LIMIT=10

# --- Session Secret (min 32 chars, random string) ---
# Generate: openssl rand -base64 32
SESSION_SECRET=replace_this_with_a_minimum_32_character_secret_string_here

# --- Admin Seeder (used by npm run seed-admin only) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_this_strong_password_before_deploying

# --- App ---
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=ReFly Payment Dashboard
# Port is set via CLI: next start -p 3040

# --- Audit Log ---
# Set to "file" — logs go to logs/audit.log
AUDIT_LOG_DEST=file
AUDIT_LOG_DIR=./logs
